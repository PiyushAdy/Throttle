# ---------------------------------------------------------------------------
# Throttle — environment template. Copy to .env and tweak.
# All defaults live in code (DECISIONS §8); everything here is an override.
# ---------------------------------------------------------------------------

# Redis connection used by the demo app and the load-test package
REDIS_URL=redis://127.0.0.1:6379

# Demo app
PORT=3000
# Express `trust proxy` setting — perIp limiting is only as honest as this (D5)
TRUST_PROXY=loopback

# Resilience (DECISIONS §13)
THROTTLE_FAIL_MODE=closed
THROTTLE_BREAKER_THRESHOLD=5
THROTTLE_BREAKER_COOLDOWN_MS=10000
THROTTLE_BREAKER_HALF_OPEN_PROBES=1

# Cost hard cap — a single request can never be charged more (D3)
THROTTLE_MAX_COST=100

# Per-tier overrides — no rebuild needed (DECISIONS §8).
# Pattern: THROTTLE_TIER_<NAME>_<CAPACITY|LIMIT|REFILL>
#   tier "authenticated" -> THROTTLE_TIER_AUTHENTICATED_CAPACITY=250
#   tier "lt-bucket"     -> THROTTLE_TIER_LT_BUCKET_CAPACITY=200
